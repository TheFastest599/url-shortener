# ==============================================================================
# API Gateway (.env.example)
# ==============================================================================
PORT=8080

# PostgreSQL Auth DB
DB_USERNAME=postgres
DB_PASSWORD=postgres_password

# JWT Security
JWT_SECRET=defaultSecretKeyWhichIsAtLeast32BytesLongForHS256BitSecurity!
JWT_EXPIRATION_MS=900000

# Google OAuth (Console: https://console.cloud.google.com/apis/credentials)
# Dev callback:    http://localhost:8080/api/v1/auth/oauth2/google/callback
# Docker callback: http://localhost/api/v1/auth/oauth2/google/callback
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (Settings: https://github.com/settings/developers)
# Dev callback:    http://localhost:8080/api/v1/auth/oauth2/github/callback
# Docker callback: http://localhost/api/v1/auth/oauth2/github/callback
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
