# ==============================================================================
# Client Application (React + Vite) - Production Build (.env.production)
# ==============================================================================
# Used by Vite during `npm run build` inside Docker.
#
# Leaving VITE_API_GATEWAY_URL empty tells the client to use relative paths
# (e.g., /api/v1/auth/me) and window.location.origin for short links.
# All requests are then cleanly routed through the unified Nginx reverse proxy.
# ==============================================================================

VITE_API_GATEWAY_URL=
