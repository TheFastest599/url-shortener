# ==============================================================================
# Analytics Service (.env.example)
# ==============================================================================
PORT=8083
GRPC_PORT=9091

# PostgreSQL (Local Dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener_analytics
DB_USERNAME=postgres
DB_PASSWORD=1234

# Kafka (Local Dev)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=analytics-ingest-group

# Batch Ingestion Tuning
ANALYTICS_BATCH_SIZE=5000
ANALYTICS_BATCH_TIMEOUT_MS=5000
ANALYTICS_BATCH_FETCH_MIN_BYTES=1048576
