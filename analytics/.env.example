# Analytics Microservice Environment Variables Example
PORT=8083
GRPC_PORT=9091
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener_analytics
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=analytics-ingest-group

# Batching & Bulk Insert Parameters
# Maximum records polled in a single batch
ANALYTICS_BATCH_SIZE=5000
# Maximum wait timeout in milliseconds before Kafka returns whatever is available (e.g. 5000ms = 5s)
ANALYTICS_BATCH_TIMEOUT_MS=5000
# Minimum bytes to accumulate before returning a fetch response (1MB)
ANALYTICS_BATCH_FETCH_MIN_BYTES=1048576
